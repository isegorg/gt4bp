				"code" : "Gt4BpTicTacToeExamples compile: 'btPreventAdjacentEdgesFork\r\t<gtExample>\r\t| adjacentEdgesMoves bThreadsAdjacentEdgesFork |\r\tadjacentEdgesMoves := self adjacentEdgesPermutations collect: [ :xMoves | \r\t    { xMoves . self class intersectionCornerFor: xMoves } flattened ].\r\t\r\tbThreadsAdjacentEdgesFork := adjacentEdgesMoves collect: [ :moves | \r\t    ''bp.registerBThread(\"AdjacentEdgesFork('', moves asString ,'')\", function() {'' , \r\tString crlf ,\r\t((moves copyFrom: 1 to: 2) flatCollect: [ :aPosition |\r\t    ''    bp.sync({ waitFor: bp.EventSet(\"X'', aPosition asString ,''\", function(e) {'' , String crlf ,\r\t    ''        return e.name == \"moveAccepted\" && '', String crlf ,\r\t    ''            e.data.player == \"X\" && '' , String crlf ,\r\t    ''            e.data.row == '', aPosition x asString , '' && '' , String crlf ,\r\t    ''            e.data.col == '', aPosition y asString , ''; '', String crlf ,\r\t    ''         }) }); '' , String crlf\r\t]) ,\r\t''    bp.sync({ request: bp.Event(\"move\", { player: \"O\", row: '', moves last x asString , '', col: '', moves last y asString , '' }) }, 70); '', String crlf ,\r''}); '', String crlf , String crlf ].\r\r\t^ String streamContents: [ :stream |\r\t    bThreadsAdjacentEdgesFork do: [ :bThread | \r\t        stream nextPutAll: bThread ] ]' classified: #'example - support'.\r\t        \rGt4BpTicTacToeExamples compile: 'adjacentEdges\r    ^ {\r        { 1@2 . 2@3 } . { 2@3 . 3@2 } .\r        { 3@2 . 2@1 } . { 2@1 . 1@2 } }.' classified: #'example - support'.\r\rGt4BpTicTacToeExamples compile: 'adjacentEdgesPermutations\r    | adjacentEdgesPermutations |\r    adjacentEdgesPermutations := OrderedCollection empty.\r    self adjacentEdges do: [ :moves |\r\t    moves permutationsDo: [:move | adjacentEdgesPermutations add: move copy ]\r    ].\r    ^ adjacentEdgesPermutations' classified: #'example - support'."
