				"code" : "adjacentEdges := {\r    { 1@2 . 2@3 } . { 2@3 . 3@2 } .\r    { 3@2 . 2@1 } . { 2@1 . 1@2 }\r}.\r    \radjacentEdgesPermutations := OrderedCollection empty.\radjacentEdges do: [ :moves |\r\tmoves permutationsDo: [:move | adjacentEdgesPermutations add: move copy ]\r].\radjacentEdgesMoves := adjacentEdgesPermutations collect: [ :xMoves | \r\t{ xMoves . Gt4BpTicTacToeExamples intersectionCornerFor: xMoves } flattened ]"
