				"code" : "bThreadsAdjacentEdgesFork := adjacentEdgesMoves collect: [ :moves | \r\t'bp.registerBThread(\"AdjacentEdgesFork(', moves asString ,')\", function() {' , \r\tString crlf ,\r\t((moves copyFrom: 1 to: 2) flatCollect: [ :aPosition |\r\t    '    bp.sync({ waitFor: bp.EventSet(\"X', aPosition asString ,'\", function(e) {' , String crlf ,\r\t    '        return e.name == \"moveAccepted\" && ', String crlf ,\r\t    '            e.data.player == \"X\" && ' , String crlf ,\r\t    '            e.data.row == ', aPosition x asString , ' && ' , String crlf ,\r\t    '            e.data.col == ', aPosition y asString , '; ', String crlf ,\r\t    '         }) }); ' , String crlf\r\t]) ,\r\t'    bp.sync({ request: bp.Event(\"move\", { player: \"O\", row: ', moves last x asString , ', col: ', moves last y asString , ' }) }, 70); ', String crlf ,\r'}); ', String crlf , String crlf ].\r\rbtPreventAdjacentEdgesFork := String streamContents: [ :stream |\r\tbThreadsAdjacentEdgesFork do: [ :bThread | stream nextPutAll: bThread ] ]"
			},
