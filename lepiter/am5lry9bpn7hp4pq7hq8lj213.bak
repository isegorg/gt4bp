				"code" : "Gt4BpTicTacToeGame\r\twithEvents: {\r\t    Gt4BpEvent new\r\t\t\tname: 'moveAccepted';\r\t\t\tdata: {'player' -> 'X'.\r\t\t\t\t\t'row' -> 1.\r\t\t\t\t\t'col' -> 2} asDictionary.\r\t\tGt4BpEvent new\r\t\t\tname: 'moveAccepted';\r\t\t\tdata: {'player' -> 'O'.\r\t\t\t\t\t'row' -> 2.\r\t\t\t\t\t'col' -> 2} asDictionary.\r\t\tGt4BpEvent new\r\t\t\tname: 'moveAccepted';\r\t\t\tdata: {'player' -> 'X'.\r\t\t\t\t\t'row' -> 2.\r\t\t\t\t\t'col' -> 1} asDictionary}"
