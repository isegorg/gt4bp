					"uidString" : "uowiX+j+DQCDGJqQBVhskg=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "The first try could be to define 2 independent b-threads requiring the events for \"Hello\" and \"World\", in the following way:"
			},
			{
				"__type" : "pharoSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-11-01T12:18:04.369128+01:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-11-01T12:20:09.466838+01:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "IFVxX+j+DQCDH6RuBVhskg=="
				},
				"code" : "btHello := '\rbp.registerBThread(\"btHello\", function() {\n  bp.sync({request:bp.Event(\"hello\")});\n});'.\r\rbtWorld := '\rbp.registerBThread(\"btWorld\", function(){\n  bp.sync({request:bp.Event(\"World\")});\n});'."
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-11-01T12:20:25.979033+01:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-11-01T12:47:22.12656+01:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "xCDiZ+j+DQCG++oEBVhskg=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "Now we can setup the previous instance of the BP Runner by **loading the two previous b-threads** and by  registering a subscriber to the bridge's announcer in order to show in the Transcript the events produced by our b-program when it runs, in the following way :"
			},
			{
				"__type" : "pharoSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-11-01T12:21:15.887321+01:00"
					}
