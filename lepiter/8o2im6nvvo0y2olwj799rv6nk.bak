				},
				"string" : "First of all, we create an instance of {{gtClass:name=Gt4BpRunnerBridge}} to interact with the BP Runner:"
			},
			{
				"__type" : "pharoSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
