					"uidString" : "Aavbauj+DQCJHgZGBVhskg=="
				},
				"code" : "bpRunner\r\tloadBProgram: btHello named: 'btHello.js';\r\tloadBProgram: btWorld named: 'btWorld.js';\r\tonEvent: [ :event | Transcript crShow: 'BP Event -> ' , event asString ]"
			},
