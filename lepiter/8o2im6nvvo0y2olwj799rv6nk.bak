				"code" : "Gt4BpExamples compile: '\rbtHello\r\t<gtExample>\r\t^ ''\rbp.registerBThread(\"btHello\", function() {\n  bp.sync({request:bp.Event(\"Hello\")});\n});''\r' classified: #'example - support'.\r\rGt4BpExamples compile: '\rbtWorld\r\t<gtExample>\r\t^ ''\rbp.registerBThread(\"btWorld\", function() {\n  bp.sync({request:bp.Event(\"World\")});\n});''\r' classified: #'example - support'.\r\rGt4BpExamples compile: '\rhelloWorldNonDeterministic\r\t<gtExample>\r\t| runner |\r\trunner := (Gt4BpRunnerBridge \r\t\tfromDirectory: (FileLocator temp / ''bt-examples'' / ''helloWorld'') asFileReference)\r\t\tonEvent: [ :event | Transcript crShow: ''BP Event -> '' , event asString ].\r\trunner \r\t\tloadBProgram: self btHello named: ''btHello.js'';\r\t\tloadBProgram: self btWorld named: ''btWorld.js''.\r\t^ runner\r' classified: #example"
			},
