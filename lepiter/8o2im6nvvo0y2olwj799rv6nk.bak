						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-11-01T12:22:13.802952+01:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "hlYBWuj+DQCDDgjeBVhskg=="
				},
				"code" : "bpRunner := Gt4BpRunnerBridge \r\tfromDirectory: (FileLocator temp / 'bt-examples' / 'helloWorld') asFileReference."
			},
			{
				"__type" : "textSnippet",
