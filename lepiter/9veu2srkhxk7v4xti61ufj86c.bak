				"code" : "Gt4BpTicTacToeExamples compile: '\rbtAddThirdO\r\t<gtExample>\r    | bThreadsAddThirdO |\r\tbThreadsAddThirdO := self linePermutations collect: [ :aLine | \r\t''bp.registerBThread(\"AddThirdO('', aLine asString ,'')\", function() {'' , \r\tString crlf ,\r\t''    bp.sync({ waitFor: bp.EventSet(\"O'', aLine first asString ,''\", function(e) {'' , String crlf ,\r\t''        return e.name == \"moveAccepted\" && '', String crlf ,\r\t''            e.data.player == \"O\" && '' , String crlf ,\r\t''            e.data.row == '', aLine first x asString , '' && '' , String crlf ,\r\t''            e.data.col == '', aLine first y asString , ''; '', String crlf ,\r\t''         }) }); '' , String crlf ,\r\t''    bp.sync({ waitFor: bp.EventSet(\"O'', aLine second asString ,''\", function(e) {'' , String crlf ,\r\t''        return e.name == \"moveAccepted\" && '', String crlf ,\r\t''            e.data.player == \"O\" && '' , String crlf ,\r\t''            e.data.row == '', aLine second x asString , '' && '' , String crlf ,\r\t''            e.data.col == '', aLine second y asString , ''; '', String crlf ,\r\t''         }) }); '' , String crlf ,\r\t''    bp.sync({ request: bp.Event(\"move\", '' ,\r\t''{ \"player\": \"O\", '',\r\t''\"row\": '', aLine third x asString , '', '' ,\r\t''\"col\": '', aLine third y asString ,\r\t''}) }, 70); '' , String crlf ,\r''}); '', String crlf , String crlf ].\r\r^ String streamContents: [ :stream |\r\tbThreadsAddThirdO do: [ :bThread | stream nextPutAll: bThread ] \r]' classified: #'example - support'."
