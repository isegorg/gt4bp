				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "For this behavior we follow a similar design to the [[Prevent third X]], i.e. we define an specific b-thread for each combination of three O's to win the game, so when the first two O's have been added, the b-thread adds the third O to win:"
			},
			{
				"__type" : "pharoSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-22T16:08:38.848405+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-22T16:09:41.271323+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "tVcNlyH+DQCcHuEGBGbCpg=="
				},
				"code" : "bThreadsAddThirdO := Gt4BpTicTacToeExamples new linePermutations collect: [ :aLine | \r\t'bp.registerBThread(\"AddThirdX(', aLine asString ,')\", function() {' , \r\tString crlf ,\r\t'    bp.sync({ waitFor: bp.EventSet(\"O', aLine first asString ,'\", function(e) {' , String crlf ,\r\t'        return e.name == \"moveAccepted\" && ', String crlf ,\r\t'            e.data.player == \"O\" && ' , String crlf ,\r\t'            e.data.row == ', aLine first x asString , ' && ' , String crlf ,\r\t'            e.data.col == ', aLine first y asString , '; ', String crlf ,\r\t'         }) }); ' , String crlf ,\r\t'    bp.sync({ waitFor: bp.EventSet(\"O', aLine second asString ,'\", function(e) {' , String crlf ,\r\t'        return e.name == \"moveAccepted\" && ', String crlf ,\r\t'            e.data.player == \"O\" && ' , String crlf ,\r\t'            e.data.row == ', aLine second x asString , ' && ' , String crlf ,\r\t'            e.data.col == ', aLine second y asString , '; ', String crlf ,\r\t'         }) }); ' , String crlf ,\r\t'    bp.sync({ request: bp.Event(\"move\", ' ,\r\t'{ \"player\": \"O\", ',\r\t'\"row\": ', aLine third x asString , ', ',\r\t'\"col\": ', aLine third y asString , \r\t'}) }, 70);' , String crlf ,\r'}); ', String crlf , String crlf ].\r\rbtAddThirdO := String streamContents: [ :stream |\t\t\r\tbThreadsAddThirdO do: [ :bThread | \r\t\tstream nextPutAll: bThread ]]"
			},
