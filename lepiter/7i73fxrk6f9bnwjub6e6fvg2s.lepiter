				"code" : "\rbtDirectory := (FileLocator temp / 'bt-examples' / 'coffee') asFileReference.\r\rbtCoffeeSuply := 'bp.registerBThread(\"coffee supply\", function() {\n  var coffeeOrderES = bp.EventSet(\"coffee orders\", function(evt){\n    return evt.name.endsWith(\"coffee\");\n  });\n  while ( true ) {\n     \t\t bp.sync({waitFor:coffeeOrderES});\n  }\t\t\t\t\n});'.\r\rbtCoffeeOrders := 'bp.registerBThread(\"coffee orders\", function() {\n    for ( var i=0; i<=14\t\t\t; i++ ) {\t\t\t\n        bp.sync({ request:bp.Event(\"espresso coffee\") });\n    }\t\t\n});'.\r\rbtCoffeeSatefy := 'bp.registerBThread(\"coffee safety\", function() {\n    var coffeeOrderES = bp.EventSet(\"coffee orders\", function(evt){\n        return evt.name.endsWith(\"coffee\");\n    });\n    for ( var i=0; i<10; i++ ) {\t\t\t\n        bp.sync({ waitFor: coffeeOrderES });\n    };\n    var eleventhEvent = bp.sync({ waitFor: bp.eventSets.all });\n    if (eleventhEvent.name !== \"Grind more coffee!\") {\n\t    bp.ASSERT(false, \"Coffee should be grinded\");\n    }\n});'.\r"
			},
