				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "We can delegate the player O moves to the program in order to play human vs machine games."
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-12T11:18:17.523446+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-12T11:19:37.585652+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "IkU/XlT9DQCO/KTKBr80cg=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "Our first approach consists of a trivial logic that waits for an X's *moveAccepted* event and then request an O's move to any free square. "
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-12T11:19:41.061471+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-12T11:19:45.725282+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "i/U5Y1T9DQCSCodfBr80cg=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "##Trivial logic"
			},
			{
				"__type" : "pharoSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-12T11:19:54.684354+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-20T11:47:51.131393+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "5NMJZFT9DQCSV9nOBr80cg=="
				},
				"code" : "btOPlayer :=\r\t'bp.registerBThread(\"OPlayer\", function() {\r\t    while (true) {\n            bp.sync({ request: [ \r\t            bp.Event(\"move\", { \"player\": \"O\", \"row\": 1, \"col\": 1}), \r\t            bp.Event(\"move\", { \"player\": \"O\", \"row\": 1, \"col\": 2}), \r\t            bp.Event(\"move\", { \"player\": \"O\", \"row\": 1, \"col\": 3}), \r\t            bp.Event(\"move\", { \"player\": \"O\", \"row\": 2, \"col\": 1}), \r\t            bp.Event(\"move\", { \"player\": \"O\", \"row\": 2, \"col\": 2}), \r\t            bp.Event(\"move\", { \"player\": \"O\", \"row\": 2, \"col\": 3}), \r\t            bp.Event(\"move\", { \"player\": \"O\", \"row\": 3, \"col\": 1}), \r\t            bp.Event(\"move\", { \"player\": \"O\", \"row\": 3, \"col\": 2}), \r\t            bp.Event(\"move\", { \"player\": \"O\", \"row\": 3, \"col\": 3}) ] });\r        }\n});'"
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-12T11:34:00.080902+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-20T12:09:14.342327+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "OY5tllT9DQCiklBnBr80cg=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "As you notice, we define a b-thread for each square. Each b-thread is waiting for any X player move and it requests the O move to that square. \n\nFor example, after the first X *moveAccepted*, the 9 b-threads we are defining  will request the O player move to its square. As all these b-threads have the same priority, the b-threads coordinator will choose randomly between all these selectable events."
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-12T14:21:14.28515+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-12T14:22:56.622019+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "flyD7Fb9DQCGrrGDDVuQdA=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "However, before try the automating of player O, it's required that we modified the previous b-thread responsible of alterning turns, because from now on we should take into account the player's value in the *move* events:"
			},
			{
				"__type" : "pharoSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-12T14:23:01.604847+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-21T18:35:04.192908+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "Fe7o8lb9DQCLKFBjDVuQdA=="
				},
				"code" : "Gt4BpTicTacToeExamples compile: '\rbtHumanVsMachineTurns\r\t^ ''bp.registerBThread(\"TurnManager\", function(){\n    var XMoveES = bp.EventSet(\"move\", function(evt) {\n\t    return (evt.data == null) ? false : (evt.name == \"move\" && evt.data.player == \"X\");\n    });\r    var OMoveES = bp.EventSet(\"move\", function(evt) {\n\t    return (evt.data == null) ? false : evt.name == \"move\" && evt.data.player == \"O\";\n    });\n    while (true) {\n        // X turn\n        var xMove = bp.sync({ waitFor: XMoveES , block: OMoveES });\n        bp.sync({ request:bp.Event(\"moveAccepted\",\n            { \"player\": \"X\",\n\t          \"row\": xMove.data.row,\n\t          \"col\": xMove.data.col })\n        }, 100);\n\n        // O turn\n        var oMove = bp.sync({ waitFor: OMoveES, block: XMoveES });\n        bp.sync({ request:bp.Event(\"moveAccepted\",\n            { \"player\": \"O\",\n\t          \"row\": oMove.data.row,\n\t          \"col\": oMove.data.col })\t\n        }, 100);\n    }\n});''' classified: #'example - support'.\r\rGt4BpTicTacToeExamples compile: '\rhumanVsMachineTurnsGame\r\t<gtExample>\r    ^ self emptyGame\r    \tloadBThread: self btHumanVsMachineTurns named: ''test-HumanVsMachineTurns.js'';\r    \tloadBThread: self btSquareTaken named: ''test-SquareTaken.js'';\r    \tloadBThread: self btXWin named: ''test-XWin.js'';\r    \tloadBThread: self btOWin named: ''test-OWin.js'';\r\t\tloadBThread: self btDraw named: ''test-Draw.js'';\r\t\tloadBThread: self btGameOver named: ''test-GameOver.js'';\r\t    yourself' classified: #example."
			},
