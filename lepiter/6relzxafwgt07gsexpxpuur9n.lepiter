				"code" : "Gt4BpTicTacToeExamples compile: '\rbtTrivialOPlayer\r    <gtExample>\r    ^ ''bp.registerBThread(\"OPlayer\", function() {\r\t    while (true) {\n            bp.sync({ request: [ \r\t            bp.Event(\"move\", { \"player\": \"O\", \"row\": 1, \"col\": 1}), \r\t            bp.Event(\"move\", { \"player\": \"O\", \"row\": 1, \"col\": 2}), \r\t            bp.Event(\"move\", { \"player\": \"O\", \"row\": 1, \"col\": 3}), \r\t            bp.Event(\"move\", { \"player\": \"O\", \"row\": 2, \"col\": 1}), \r\t            bp.Event(\"move\", { \"player\": \"O\", \"row\": 2, \"col\": 2}), \r\t            bp.Event(\"move\", { \"player\": \"O\", \"row\": 2, \"col\": 3}), \r\t            bp.Event(\"move\", { \"player\": \"O\", \"row\": 3, \"col\": 1}), \r\t            bp.Event(\"move\", { \"player\": \"O\", \"row\": 3, \"col\": 2}), \r\t            bp.Event(\"move\", { \"player\": \"O\", \"row\": 3, \"col\": 3}) ] });\r        }\n});''' classified: #'example - support'.\r\rGt4BpTicTacToeExamples compile: '\rhumanVsMachineTrivialGame\r\t<gtExample>\r    ^ self humanVsMachineTurnsGame\r\t\tloadBThread: self btTrivialOPlayer named: ''test-TrivialOPlayer.js'';\r\t    yourself' classified: #example."
