					"uidString" : "13vNY0b+DQCTrQD5BGI9OA=="
				},
				"code" : "Gt4BpTicTacToeGame\r\twithEvents: {\r\t    Gt4BpEvent new\r\t\t\tname: 'moveAccepted';\r\t\t\tdata: {'player' -> 'X'.\r\t\t\t\t\t'row' -> 1.\r\t\t\t\t\t'col' -> 1} asDictionary.\r\t\tGt4BpEvent new\r\t\t\tname: 'moveAccepted';\r\t\t\tdata: {'player' -> 'O'.\r\t\t\t\t\t'row' -> 2.\r\t\t\t\t\t'col' -> 2} asDictionary.\r\t\tGt4BpEvent new\r\t\t\tname: 'moveAccepted';\r\t\t\tdata: {'player' -> 'X'.\r\t\t\t\t\t'row' -> 3.\r\t\t\t\t\t'col' -> 3} asDictionary}"
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-24T12:04:09.443089+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-24T12:08:17.636403+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "L7teaEb+DQCT+vm9BGI9OA=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "As the X player has two ways available to create the fork (the two free corners), the O player cannot avoid them directly.  In this case,  **the best defense is a good offense**, and O player move to (2,1). This move creates an attack that forces X to play to (2,3) and it avoids the fork threat."
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-24T12:09:19.877103+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-24T12:09:22.41828+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "oJffekb+DQCYtZECA9j1Ag=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "##Behavior encoding as b-threads"
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-24T12:14:37.347162+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-24T12:15:32.076344+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "8UQZe0b+DQCYvF9qA9j1Ag=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "As in the previous fork cases we'll follow a **stateless design** with each b-thread monitoring for an specific fork threat pattern."
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-24T12:15:48.94408+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-24T12:16:09.449225+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "RUIQkkb+DQCZitTCA9j1Ag=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "Also we're going to programmatically generate these b-threads with Smalltalk code in the following way:"
			},
			{
				"__type" : "pharoSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-24T12:16:12.845889+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-24T12:22:33.67094+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "X/t8k0b+DQCaHwpGA9j1Ag=="
				},
				"code" : "xOpossiteCorners := {\r    { 1@1 . 3@3 } . { 3@3 . 1@1 } .\r    { 3@1 . 1@3 } . { 1@3 . 3@1 }\r}."
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-24T12:22:39.531907+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-24T12:44:44.393088+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "o1eJqkb+DQCbZktGA9j1Ag=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "For each of the previously  squares we define a specific b-thread watching for *the first 2 X moves* and the first O move at the center square, and then it requests O move to the (2,1) square."
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-24T12:23:59.133811+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-24T12:25:38.668619+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "OvZHr0b+DQCdF4urA9j1Ag=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "Note that, in that case, we are only interested in the first 3 moves of the game, so the b-thread exits (using the *interrupt* to declare that any oner different event interrupts the b-thread):\t\t\t"
			},
			{
				"__type" : "pharoSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-24T12:25:41.913361+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-24T12:59:41.771156+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "MENotUb+DQCiL2KCA9j1Ag=="
				},
				"code" : "bThreadsCornerOpossiteCornerFork := xOpossiteCorners collect: [ :moves | \r\t'bp.registerBThread(\"CornerOpossiteCornerFork(', moves asString ,')\", function() {' , \r\tString crlf ,\r\t'    bp.setInterruptHandler(function(evt) { bp.log.warn(\"Interrupted: \" + evt); });', String crlf ,\r\t'    const firstX = bp.EventSet(\"firstX\", function(e) { return e.name == \"moveAccepted\" && e.data.player == \"X\" && e.data.row == ' , moves first x asString , ' && e.data.col == ', moves first y asString ,'; }); ', String crlf,\r\t'    const notFirstX = bp.EventSet(\"firstX\", function(e) { return e.name == \"moveAccepted\" && e.data.player == \"X\" && (e.data.row != ' , moves first x asString , ' || e.data.col != ', moves first y asString ,'); }); ', String crlf,\r\t'    const secondX = bp.EventSet(\"firstX\", function(e) { return e.name == \"moveAccepted\" && e.data.player == \"X\" && e.data.row == ' , moves second x asString , ' && e.data.col == ', moves second y asString ,'; }); ', String crlf,\r    '    const notSecondX = bp.EventSet(\"firstX\", function(e) { return e.name == \"moveAccepted\" && e.data.player == \"X\" && (e.data.row != ' , moves second x asString , ' || e.data.col != ', moves second y asString ,'); }); ', String crlf,\r\t'    const centerO = bp.EventSet(\"centerO\", function(e) { return e.name == \"moveAccepted\" && e.data.player == \"O\" && e.data.row == 2 && e.data.col == 2; }); ', String crlf,\r\t'    const notCenterO = bp.EventSet(\"centerO\", function(e) { return e.name == \"moveAccepted\" && e.data.player == \"O\" && (e.data.row != 2 || e.data.col != 2); }); ', String crlf, String crlf,\r\t'    bp.sync({ waitFor: firstX, interrupt: notFirstX });' , String crlf ,\r\t'    bp.sync({ waitFor: centerO, interrupt: notCenterO  });', String crlf ,\r\t'    bp.sync({ waitFor: secondX, interrupt: notSecondX  });' , String crlf ,\r\t'    bp.sync({ request: bp.Event(\"move\", { player: \"O\", row: 2, col: 1 }) }, 70);' , String crlf ,\r\t'});', String crlf, String crlf ].\r\rbtPreventCornerOpossiteCornerFork := String streamContents: [ :stream |\r\tbThreadsCornerOpossiteCornerFork do: [ :bThread | stream nextPutAll: bThread ] ]"
			},
