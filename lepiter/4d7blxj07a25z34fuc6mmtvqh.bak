				"code" : "Gt4BpTicTacToeExamples compile: '\rbtOPlayerCenter\r    <gtExample>\r    ^ ''bp.registerBThread(\"OPlayerCenter\", function() {\r    while (true) {\n        bp.sync({ request: \r            bp.Event(\"move\", { \"player\": \"O\", \"row\": 2, \"col\": 2}) \r        }, 50);\r    }\n});''' classified: #'example - support'.\r\rGt4BpTicTacToeExamples compile: '\rbtOPlayerCorners\r    <gtExample>\r    ^ ''bp.registerBThread(\"OPlayerCorners\", function() {\r    while (true) {\n        bp.sync({ request: [\r            bp.Event(\"move\", { \"player\": \"O\", \"row\": 1, \"col\": 1}),\r            bp.Event(\"move\", { \"player\": \"O\", \"row\": 1, \"col\": 3}),\r            bp.Event(\"move\", { \"player\": \"O\", \"row\": 3, \"col\": 1}),\r            bp.Event(\"move\", { \"player\": \"O\", \"row\": 3, \"col\": 3}) ] \r        }, 40);\r    }\n});''' classified: #'example - support'.\r\rGt4BpTicTacToeExamples compile: '\rbtOPlayerEdges\r    <gtExample>\r    ^ ''bp.registerBThread(\"OPlayerEdges\", function() {\r    while (true) {\n        bp.sync({ request: [\r            bp.Event(\"move\", { \"player\": \"O\", \"row\": 1, \"col\": 2}),\r            bp.Event(\"move\", { \"player\": \"O\", \"row\": 2, \"col\": 1}),\r            bp.Event(\"move\", { \"player\": \"O\", \"row\": 2, \"col\": 3}),\r            bp.Event(\"move\", { \"player\": \"O\", \"row\": 3, \"col\": 2}) ] \r        }, 30);\r    }\n});''' classified: #'example - support'.\r\rGt4BpTicTacToeExamples compile: '\rhumanVsMachineWithPreferedSquaresGame\r\t<gtExample>\r    ^ self humanVsMachineTrivialGame\r\t\tloadBThread: self btOPlayerCenter named: ''test-OPlayerCenter.js'';\r\t\tloadBThread: self btOPlayerCorners named: ''test-OPlayerCorners.js'';\r\t\tloadBThread: self btOPlayerEdges named: ''test-OPlayerEdges.js'';\r\t    yourself' classified: #example."
			}
