					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-21T18:30:09.200055+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
