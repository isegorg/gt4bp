				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "We can benefit from the *prioritized event selection strategy* used by the b-threads coordinator to be able to express behaviors to prefer the O moves in the following **order of center, corners and edges**.\n\nNote the use of the second argument of the *registerBThread* function in order to define the priority value for the synchronization points in the following b-threads:"
			},
			{
				"__type" : "pharoSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-21T18:09:31.269485+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-21T18:38:37.2265+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "jSF9KQ/+DQC958PjBIXCSQ=="
				},
				"code" : "btOPlayerCenter := 'bp.registerBThread(\"OPlayerCenter\", function() {\r    while (true) {\n        bp.sync({ request: \r            bp.Event(\"move\", { \"player\": \"O\", \"row\": 2, \"col\": 2}) \r        }, 50);\r    }\n});'.\r\r\rbtOPlayerCorners := 'bp.registerBThread(\"OPlayerCorners\", function() {\r    while (true) {\n        bp.sync({ request: [\r            bp.Event(\"move\", { \"player\": \"O\", \"row\": 1, \"col\": 1}),\r            bp.Event(\"move\", { \"player\": \"O\", \"row\": 1, \"col\": 3}),\r            bp.Event(\"move\", { \"player\": \"O\", \"row\": 3, \"col\": 1}),\r            bp.Event(\"move\", { \"player\": \"O\", \"row\": 3, \"col\": 3}) ] \r        }, 40);\r    }\n});'.\r\rbtOPlayerEdges := 'bp.registerBThread(\"OPlayerEdges\", function() {\r    while (true) {\n        bp.sync({ request: [\r            bp.Event(\"move\", { \"player\": \"O\", \"row\": 1, \"col\": 2}),\r            bp.Event(\"move\", { \"player\": \"O\", \"row\": 2, \"col\": 1}),\r            bp.Event(\"move\", { \"player\": \"O\", \"row\": 2, \"col\": 3}),\r            bp.Event(\"move\", { \"player\": \"O\", \"row\": 3, \"col\": 2}) ] \r        }, 30);\r    }\n});'."
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
