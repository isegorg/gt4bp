				"uid" : {
					"__type" : "uid",
					"uidString" : "8S4CpBH+DQCdUzmnCJxJVg=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "The following strategy prevents the third move in a line of player X.\t"
			},
			{
				"__type" : "textSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-21T21:18:25.006129+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-22T15:08:58.542092+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "cToIzRH+DQCgOIMpCJxJVg=="
				},
				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "As in the case of the [[Detect winner]] behavior, the following b-threads do not maintain a copy of the board, but instead are simply waiting for very specific two events in a given order and responding with a third event.\n\nThus, there is a separate instance of a b-thread for each ordering of the three events in each row, column and diagonal:"
			},
			{
				"__type" : "pharoSnippet",
				"children" : {
					"__type" : "snippets",
					"items" : [ ]
				},
				"createEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"createTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-22T15:09:26.088537+02:00"
					}
				},
				"editEmail" : {
					"__type" : "email",
					"emailString" : "<unknown>"
				},
				"editTime" : {
					"__type" : "time",
					"time" : {
						"__type" : "dateAndTime",
						"dateAndTimeString" : "2025-10-22T15:52:01.897374+02:00"
					}
				},
				"uid" : {
					"__type" : "uid",
					"uidString" : "godKwyD+DQC/XNQlDBhQSw=="
				},
				"code" : "bThreadsPreventThirdX := Gt4BpTicTacToeExamples new linePermutations collect: [ :aLine | \r\t'bp.registerBThread(\"PreventThirdX(', aLine asString ,')\", function() {' , \r\tString crlf ,\r\t'    bp.sync({ waitFor: bp.EventSet(\"X', aLine first asString ,'\", function(e) {' , String crlf ,\r\t'        return e.name == \"moveAccepted\" && ', String crlf ,\r\t'            e.data.player == \"X\" && ' , String crlf ,\r\t'            e.data.row == ', aLine first x asString , ' && ' , String crlf ,\r\t'            e.data.col == ', aLine first y asString , '; ', String crlf ,\r\t'         }) }); ' , String crlf ,\r\t'    bp.sync({ waitFor: bp.EventSet(\"X', aLine second asString ,'\", function(e) {' , String crlf ,\r\t'        return e.name == \"moveAccepted\" && ', String crlf ,\r\t'            e.data.player == \"X\" && ' , String crlf ,\r\t'            e.data.row == ', aLine second x asString , ' && ' , String crlf ,\r\t'            e.data.col == ', aLine second y asString , '; ', String crlf ,\r\t'         }) }); ' , String crlf ,\r\t'    bp.sync({ request: bp.Event(\"move\", ' ,\r\t'{ \"player\": \"O\", ',\r\t'\"row\": ', aLine third x asString , ', ',\r\t'\"col\": ', aLine third y asString , \r\t'}) }, 60);' , String crlf ,\r'}); ', String crlf , String crlf ].\r\rbtPreventThirdX := String streamContents: [ :stream |\t\t\r\tbThreadsPreventThirdX do: [ :bThread | \r\t\tstream nextPutAll: bThread ]]"
			},
