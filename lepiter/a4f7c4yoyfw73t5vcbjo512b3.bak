				"code" : "Gt4BpTicTacToeExamples compile: 'btXShouldNeverWin\r\t^ ''bp.registerBThread(\"XShouldNeverWin\", function() {\r\t    var XWinES = bp.EventSet(\"XWin\", function(evt) {\r\t    \treturn evt.data == null ? false : (evt.name == \"gameOver\" && evt.data.winner == \"X\");\r\t    });\n        bp.sync({ waitFor: XWinES });\r        bp.ASSERT(false, \"X should never win\");\n});''' classified: #'example - support'.\r\rGt4BpTicTacToeExamples compile: 'btXPlayer\r\t^ ''bp.registerBThread(\"XPlayer\", function() {\r\t    while(true) {\n\t        bp.sync({ request: [ \r\t            bp.Event(\"move\", { \"player\": \"X\", \"row\": 1, \"col\": 1}), \r\t            bp.Event(\"move\", { \"player\": \"X\", \"row\": 1, \"col\": 2}), \r\t            bp.Event(\"move\", { \"player\": \"X\", \"row\": 1, \"col\": 3}), \r\t            bp.Event(\"move\", { \"player\": \"X\", \"row\": 2, \"col\": 1}), \r\t            bp.Event(\"move\", { \"player\": \"X\", \"row\": 2, \"col\": 2}), \r\t            bp.Event(\"move\", { \"player\": \"X\", \"row\": 2, \"col\": 3}), \r\t            bp.Event(\"move\", { \"player\": \"X\", \"row\": 3, \"col\": 1}), \r\t            bp.Event(\"move\", { \"player\": \"X\", \"row\": 3, \"col\": 2}), \r\t            bp.Event(\"move\", { \"player\": \"X\", \"row\": 3, \"col\": 3}) ]});\r\t        }\r});''' classified: #'example - support'."
