				"code" : "Gt4BpTicTacToeExamples compile: 'btPreventCornerOppositeEdgeFork\r\t<gtExample>\r\t| cornerEdgesMoves bThreadsCornerOppositeEdgeFork |\r\tcornerEdgesMoves := self cornerOppositeEdgePermutations collect: [ :xMoves | \r\t    { xMoves . self class intersectionCornerFor: xMoves } flattened ].\r\t\r\tbThreadsCornerOppositeEdgeFork := cornerEdgesMoves collect: [ :moves | \r\t    ''bp.registerBThread(\"XFork('', moves asString ,'')\", function() {'' , \r\tString crlf ,\r\t((moves copyFrom: 1 to: 2) flatCollect: [ :aPosition |\r\t    ''    bp.sync({ waitFor: bp.EventSet(\"X'', aPosition asString ,''\", function(e) {'' , String crlf ,\r\t    ''        return e.name == \"moveAccepted\" && '', String crlf ,\r\t    ''            e.data.player == \"X\" && '' , String crlf ,\r\t    ''            e.data.row == '', aPosition x asString , '' && '' , String crlf ,\r\t    ''            e.data.col == '', aPosition y asString , ''; '', String crlf ,\r\t    ''         }) }); '' , String crlf\r\t]) ,\r\t''    bp.sync({ request: bp.Event(\"move\", { player: \"O\", row: '', moves last x asString , '', col: '', moves last y asString , '' }) }, 70); '', String crlf ,\r''}); '', String crlf , String crlf ].\r\r\t^ String streamContents: [ :stream |\r\t    bThreadsCornerOppositeEdgeFork do: [ :bThread | \r\t        stream nextPutAll: bThread ] ]' classified: #'example - support'.\r\rGt4BpTicTacToeExamples compile: 'cornerOppositeEdges\r\t^ { { 1@1 . 3@2 } . { 1@1 . 2@3 } .\r    { 1@3 . 2@1 } . { 1@3 . 3@2 } .\r    { 3@3 . 1@2 } . { 3@3 . 2@1 } .\r    { 3@1 . 1@2 } . { 3@1 . 2@3 } }' classified: #'example - support'.\r\rGt4BpTicTacToeExamples compile: 'cornerOppositeEdgePermutations\r\t| cornerEdgesPermutations |\r\tcornerEdgesPermutations := OrderedCollection empty.\r    self cornerOppositeEdges do: [ :moves |\r\t    moves permutationsDo: [:move | cornerEdgesPermutations add: move copy ].\r    ].\r    ^ cornerEdgesPermutations' classified: #'example - support'.\r\rGt4BpTicTacToeExamples class compile: 'intersectionCornerFor: aPairOfSquares \r\t| s1 s2 |\r\ts1 := aPairOfSquares first.\r\ts2 := aPairOfSquares second.\r    ^ { 1@1 . 1@3 . 3@1 . 3@3 } detect: [ :aCorner | \r    \t(aCorner x = s1 x and: [ aCorner y = s2 y ]) or: [\r    \t\taCorner x = s2 x and: [ aCorner y = s1 y ]]\r    ]' classified: #'example - support'."
